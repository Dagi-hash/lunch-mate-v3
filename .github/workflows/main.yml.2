name: Build LunchMate APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Show repo files (for debugging)
        run: ls -la && ls -la www || true

      - name: Make sure the www folder exists
        shell: bash
        run: |
          if [ ! -f www/index.html ]; then
            if [ -f index.html ]; then
              echo "www folder missing - rebuilding it from the files in the repo root"
              mkdir -p www
              for f in index.html app.js styles.css reminder.wav fonts icons; do
                if [ -e "$f" ]; then cp -r "$f" www/; fi
              done
            else
              echo "::error::The www folder is missing from your repo. Upload the whole www folder (drag the folder itself into GitHub's Upload files page)."
              exit 1
            fi
          fi
          ls -la www

      - name: Set up Node
        uses: actions/setup-node@v5
        with:
          node-version: 20

      - name: Set up Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: 17

      - name: Install dependencies
        run: npm install

      - name: Create Android project
        run: npx cap add android

      - name: Apply LunchMate native customisations
        shell: bash
        run: |
          set -e
          APP=android/app/src/main
          RES=$APP/res

          if [ -d resources/android/res ]; then cp -r resources/android/res/. "$RES/"; fi
          mkdir -p "$RES/raw"
          if [ -f resources/android/raw/reminder.wav ]; then cp resources/android/raw/reminder.wav "$RES/raw/reminder.wav"; fi
          cat > "$RES/values/ic_launcher_background.xml" <<'XML'
          <?xml version="1.0" encoding="utf-8"?>
          <resources>
              <color name="ic_launcher_background">#2A93EE</color>
          </resources>
          XML

          find "$RES" -name 'splash.png' -delete
          mkdir -p "$RES/drawable"
          cat > "$RES/drawable/splash.xml" <<'XML'
          <?xml version="1.0" encoding="utf-8"?>
          <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
              <solid android:color="#2A93EE"/>
          </shape>
          XML

          MANIFEST=$APP/AndroidManifest.xml
          for P in POST_NOTIFICATIONS VIBRATE SCHEDULE_EXACT_ALARM USE_EXACT_ALARM RECEIVE_BOOT_COMPLETED; do
            grep -q "android.permission.$P" "$MANIFEST" || sed -i "s#<uses-permission android:name=\"android.permission.INTERNET\" />#&\n    <uses-permission android:name=\"android.permission.$P\" />#" "$MANIFEST"
          done

          mkdir -p "$APP/java/com/lunchmate/app"
          cat > "$APP/java/com/lunchmate/app/MainActivity.java" <<'JAVA'
          package com.lunchmate.app;

          import android.os.Bundle;
          import android.view.View;
          import com.getcapacitor.BridgeActivity;

          public class MainActivity extends BridgeActivity {
              @Override
              public void onCreate(Bundle savedInstanceState) {
                  super.onCreate(savedInstanceState);
                  try { getBridge().getWebView().setOverScrollMode(View.OVER_SCROLL_NEVER); } catch (Exception ignored) { }
              }
          }
          JAVA

      - name: Sync web assets
        run: npx cap sync android

      - name: Build debug APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: LunchMate-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
